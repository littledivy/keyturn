SECRET_KEY=replace-with-a-long-random-value
APP_URL=http://127.0.0.1:5051
PORT=5051
STATE_DIR=/data
COOKIE_SECURE=false

# Transactional alert email (any SMTP provider)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
ALERT_FROM=
WATCH_INTERVAL_SECONDS=240

# Either use a static Maps token or dynamically sign short-lived tokens.
MAPKIT_TOKEN=
MAPKIT_TEAM_ID=
MAPKIT_KEY_ID=
MAPKIT_PRIVATE_KEY_PATH=
MAPKIT_PRIVATE_KEY=
MAPKIT_ORIGIN=127.0.0.1
